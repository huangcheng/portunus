# Copy to .env and fill in. Never commit a real .env.
# Generate material with: ./scripts/init_env.sh

PORTUNUS_SECRETS_KEY=k1:REPLACE_WITH_BASE64_32_RANDOM_BYTES
PORTUNUS_OPERATOR_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Optional once an operator account exists. While this is set, first-run setup
# must send it as bootstrap_password. Do not commit the Turnstile secret.
# PORTUNUS_TURNSTILE_SITEKEY=0x4AAAAAAGBsF0uydauQCt2F
# PORTUNUS_TURNSTILE_SECRET=REPLACE_WITH_TURNSTILE_SECRET
# PORTUNUS_TURNSTILE_HOSTNAMES=portunus.wuhan.dev,wuhan.dev,localhost,127.0.0.1
PORTUNUS_DEV=1
# Public MCP base (no trailing slash). Used for Origin allowlist + RFC 9728 metadata.
# PORTUNUS_PUBLIC_URL=https://portunus.example.com
# Extra browser Origins allowed to POST /mcp (comma-separated). PUBLIC_URL origin is always included.
# PORTUNUS_ALLOWED_ORIGINS=https://portunus.example.com
# PORTUNUS_DATABASE_URL=sqlite+aiosqlite:///./data/portunus.db
# WITH_POSTGRES=0
#
# Vultr / docker-compose.gateway.yml (colocated Postgres):
# POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# (also write the same value to secrets/postgres.password; compose builds
#  PORTUNUS_DATABASE_URL=postgresql+asyncpg://portunus:${POSTGRES_PASSWORD}@postgres:5432/portunus)


# Fleet (optional; defaults keep a single "local" runner). Runner side, placeholder names only:
# PORTUNUS_SITE_ID=site-a
# PORTUNUS_REGIONS=region-a
# Gateway side, pool several runners instead of PORTUNUS_SOCKET/PORTUNUS_TOKEN_FILE
# ([site=]socket_path:token_file, comma separated):
# PORTUNUS_RUNNERS=/run/portunus/a.sock:/run/portunus/a.token,/run/portunus/b.sock:/run/portunus/b.token
# Local check: ./scripts/e2e_two_runners.sh
