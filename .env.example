# Copy to .env and fill in. Never commit a real .env.
# Generate material with: ./scripts/init_env.sh

PORTUNUS_SECRETS_KEY=k1:REPLACE_WITH_BASE64_32_RANDOM_BYTES
PORTUNUS_OPERATOR_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PORTUNUS_DEV=1
# PORTUNUS_DATABASE_URL=sqlite+aiosqlite:///./data/portunus.db
# WITH_POSTGRES=0

# Fleet (optional; defaults keep a single "local" runner). Runner side, placeholder names only:
# PORTUNUS_SITE_ID=site-a
# PORTUNUS_REGIONS=region-a
# Gateway side, pool several runners instead of PORTUNUS_SOCKET/PORTUNUS_TOKEN_FILE
# ([site=]socket_path:token_file, comma separated):
# PORTUNUS_RUNNERS=/run/portunus/a.sock:/run/portunus/a.token,/run/portunus/b.sock:/run/portunus/b.token
# Local check: ./scripts/e2e_two_runners.sh
