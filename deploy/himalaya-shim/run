#!/usr/bin/env python3
"""Portunus Himalaya CLI wrapper (runner-local).

Launch form (skill-bridge ``cli.command``): absolute path, remaining argv are
Himalaya subcommands + skill-bridge ``--flag`` inputs.

  IMAP_URL / SMTP_URL / MAIL_ADDRESS / MAIL_PASSWORD   Connect vault + defaults
  HIMALAYA_BIN   optional override (default: himalaya beside this script)

Writes a 0600 one-account config under STATE_DIR (or mkdtemp), then execs::

  himalaya --json -c <cfg> -a portunus <subcommand…>

``MAIL_PASSWORD`` is stripped from the child environment.
"""

from __future__ import annotations

import os
import stat
import sys
import tempfile
from pathlib import Path

_HERE = Path(__file__).resolve().parent
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

from himalaya_config import build_config_from_env, rewrite_argv  # noqa: E402

ACCOUNT = "portunus"


def _die(msg: str, code: int = 2) -> None:
    print(f"himalaya-shim: {msg}", file=sys.stderr, flush=True)
    raise SystemExit(code)


def _himalaya_bin() -> Path:
    override = (os.environ.get("HIMALAYA_BIN") or "").strip()
    if override:
        path = Path(override)
    else:
        path = _HERE / "himalaya"
    if not path.is_file() or not os.access(path, os.X_OK):
        _die(f"himalaya binary missing or not executable: {path}")
    return path


def _config_dir() -> Path:
    state = (os.environ.get("STATE_DIR") or "").strip()
    if state:
        root = Path(state)
        root.mkdir(parents=True, exist_ok=True)
        conf = root / "himalaya"
        conf.mkdir(parents=True, exist_ok=True)
        return conf
    return Path(tempfile.mkdtemp(prefix="portunus-himalaya-"))


def main(argv: list[str] | None = None) -> None:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        _die("usage: run <himalaya-subcommand…>")

    try:
        text = build_config_from_env(dict(os.environ))
    except ValueError as e:
        _die(str(e))

    conf_dir = _config_dir()
    cfg_path = conf_dir / "config.toml"
    fd = os.open(str(cfg_path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(cfg_path, stat.S_IRUSR | stat.S_IWUSR)

    himalaya = _himalaya_bin()
    child_argv = [
        str(himalaya),
        "--json",
        "-c",
        str(cfg_path),
        "-a",
        ACCOUNT,
        *rewrite_argv(args),
    ]
    env = {k: v for k, v in os.environ.items() if k != "MAIL_PASSWORD"}
    try:
        os.execve(str(himalaya), child_argv, env)
    except OSError as e:
        _die(f"exec failed: {e}", code=127)


if __name__ == "__main__":
    main()
